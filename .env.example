# ── Enterprise Agentic AI Platform — Environment Variables ───────────────────
# Copy to .env and fill in your values. Never commit .env to version control.

# ── Application ───────────────────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
APP_VERSION=1.0.0

# ── Security (generate with: openssl rand -hex 32) ────────────────────────────
SECRET_KEY=REPLACE_WITH_64_CHAR_RANDOM_HEX_STRING

# ── Anthropic ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-4-20250514
CLAUDE_MAX_TOKENS=8192

# ── PostgreSQL ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://aip_user:changeme@localhost:5432/agentic_ai
POSTGRES_PASSWORD=changeme

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://:changeme@localhost:6379/0
REDIS_PASSWORD=changeme

# ── Qdrant ────────────────────────────────────────────────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=knowledge_base

# ── Celery ────────────────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://:changeme@localhost:6379/1
CELERY_RESULT_BACKEND=redis://:changeme@localhost:6379/2

# ── CORS ──────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# ── Observability (optional) ──────────────────────────────────────────────────
SENTRY_DSN=
METRICS_ENABLED=true
