FROM node:20-alpine
WORKDIR /app
RUN echo '{"name":"frontend","version":"1.0.0","scripts":{"dev":"node server.js","start":"node server.js"}}' > package.json
RUN echo 'const http = require("http"); http.createServer((req,res) => { res.writeHead(200); res.end("Agentic AI Platform - Frontend Coming Soon"); }).listen(3000, () => console.log("Frontend on port 3000"));' > server.js
EXPOSE 3000
CMD ["node", "server.js"]
